import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from sensor_msgs.msg import Imu # 引入标准的IMU消息类型
import serial
import struct

class SteadyMotorDriver(Node):
    def __init__(self):
        super().__init__('steady_motor_driver')

        # --- 核心安全参数调节 ---
        self.ratio = 0.835        # 标定系数
        self.max_rpm = 80.0      # 限制最高转速为 300 RPM
        self.accel = 2            # 进一步调低：每一帧(10ms)只动 2 RPM
                                  # 意味着 1秒钟才增加 200 RPM，起步极其平稳
        self.sync_diff_limit = 10 # 同步容忍度：两轮反馈差超过此值将协同限速
        
        
        #IMU数据校准及滤波
        self.static_count = 0 #静止时的积分
        self.gyro_offset = 0.0 # 零偏（静止时的数值）
        self.gyro_alpha = 0.3       # 滤波系数（越小越平滑）
        self.filtered_gyro = 0.0
        self.yaw_kp = 0.05          # 纠偏增益（根据实测黄色线跳动幅度调整）

        # 新增：IMU 数据发布者（发给 Foxglove 看）
        self.imu_pub = self.create_publisher(Imu, '/motor_imu', 10)
        # 转速发送
        self.feedback_pub = self.create_publisher(Twist, '/motor_feedback', 10)

        # 串口和数据初始化
        self.ports = {'L': '/dev/ttyS4', 'R': '/dev/ttyS3'}
        self.uarts = {}
        self.data = {
            'L': {'target': 0.0, 'current': 0.0, 'real': 0, 'gyroZ': 0},
            'R': {'target': 0.0, 'current': 0.0, 'real': 0, 'gyroZ': 0}
        }

        for side, path in self.ports.items():
            try:
                self.uarts[side] = serial.Serial(path, 115200, timeout=0)
                self.get_logger().info(f"{side}侧稳健模式初始化成功")
            except Exception as e:
                self.get_logger().error(f"无法开启 {side} 串口: {e}")

        self.create_subscription(Twist, '/cmd_vel', self.cmd_callback, 10)
        self.create_timer(0.01, self.control_loop) # 100Hz 核心频率
        self.create_timer(0.1,self.publish_feedback)
        self.create_timer(0.2, self.status_report) # 5Hz 报告，减少终端负担
        self.feedback_pub = self.create_publisher(Twist, '/motor_feedback', 10)

    def cmd_callback(self, msg):
        """ 解析指令并限制上限 """
        v = msg.linear.x * self.max_rpm
        w = msg.angular.z * 100.0 # 转向保持适中灵敏度

        # 严格限速
        self.data['L']['target'] = max(min(v - w, self.max_rpm), -self.max_rpm)
        self.data['R']['target'] = max(min(v + w, self.max_rpm), -self.max_rpm)


    def control_loop(self):
        """
        100Hz 核心控制循环
        包含：起步死区补偿、线性斜率控制、物理同步发送、逻辑方向对齐
        """

        # 1. 逻辑计算层：先算出左右轮本帧应该发出的 current 值
        for side in ['L', 'R']:
            d = self.data[side]
            target = d['target']
            current = d['current']

            # --- 阈值处理：小于50转视为停止，跳过扭矩不稳定区 ---
            if abs(target) < 50.0:
                final_target = 0.0
            else:
                final_target = target

            # --- 步进与死区补偿逻辑 ---
            if final_target != 0:
                # 起步阶跃：如果当前静止，直接跳到 50RPM 越过静摩擦力
                if abs(current) < 50.0:
                    d['current'] = 50.0 if final_target > 0 else -50.0

                # 线性爬升：以 accel=2 的节奏平滑逼近目标
                if d['current'] < final_target:
                    d['current'] = min(d['current'] + self.accel, final_target)
                elif d['current'] > final_target:
                    d['current'] = max(d['current'] - self.accel, final_target)
            else:
                # 停止逻辑：减速到 50 以下时直接归零，防止电机“打冷颤”
                if abs(current) < 50.0:
                    d['current'] = 0.0
                else:
                    if current > 0:
                        d['current'] -= self.accel
                    else:
                        d['current'] += self.accel

        # 2. 物理执行层：紧凑同步发送 (Atomic Write)
        # ==========================================
        # 【新增：高阶纠偏逻辑】 放在计算完 current 后，打包发送前
        # ==========================================
        target_l = self.data['L']['target']
        target_r = self.data['R']['target']

        # 判定条件：目标速度不为0，且两轮目标一致（代表你想走直线）
        if abs(target_l) > 100 and target_l == target_r:
            # 黄色线纠偏：
            # 如果 filtered_gyro 为正（向左偏），左轮减速，右轮加速
            correction = self.filtered_gyro * self.yaw_kp
            
            # 直接微调这一帧要发出去的 current 值
            self.data['L']['current'] -= correction
            self.data['R']['current'] += correction
            
        # 预先构建二进制包，减少串口间的计算延迟
        packets = {}
        for side in ['L', 'R']:
            val = self.data[side]['current']
            # 右轮物理镜像取反
            send_val = -val if side == 'R' else val
            cal_cmd = int(send_val * self.ratio)
            header = 0xABCD
            cs = (header ^ 0 ^ cal_cmd) & 0xFFFF
            packets[side] = struct.pack("<HhhH", header, 0, cal_cmd, cs)

        # 连续写入，中间不插入任何解析代码，确保两轮起步动作“齐步走”
        if 'L' in self.uarts: self.uarts['L'].write(packets['L'])
        if 'R' in self.uarts: self.uarts['R'].write(packets['R'])

        # 3. 反馈解析层：异步读取驱动板状态
        for side, ser in self.uarts.items():
            if ser.in_waiting >= 36:
                raw = ser.read(ser.in_waiting)
                idx = raw.rfind(b'\xcd\xab')
                if idx != -1 and len(raw) - idx >= 36:
                    pkt = raw[idx:idx+36]
                    try:
                        # 严格对应你的 struct ReceivePacket (36字节)
                        # H: uint16, h: int16
                        res = struct.unpack("<HHHHHhhhhhhh hhhhh H", pkt)
                        
                        # 对应你提供的结构体顺序：
                        # res[5] = speed_meas
                        # res[13] = gyroZ (陀螺仪 Z 轴，反映旋转)
                        raw_gyro_z = float(res[13]) 
                        target_speed = abs(self.data['L']['target']) + abs(self.data['R']['target'])
                        # 1. 自动判定静止：没有目标速度且电机基本停稳
                        if target_speed == 0 and abs(self.data['L']['real']) < 5:
                            self.static_count += 1
                            # 持续静止超过 0.5 秒 (50 帧) 后，开始微调零点
                            if self.static_count > 50:
                                # 使用极小的权重（0.01）让零点缓慢向当前观测值靠拢
                                # 这样可以过滤掉偶尔的震动，只跟踪长期的漂移
                                self.gyro_offset = (self.gyro_offset * 0.99) + (raw_gyro_z * 0.01)
                        else:
                            # 一旦动起来，就锁定当前的零点，不再更新
                            self.static_count = 0
                        
                        # 2. 应用动态零点
                        corrected_gyro = raw_gyro_z - self.gyro_offset
                        
                        # 简单的低通滤波，让黄色线更丝滑
                        self.filtered_gyro = (1 - self.gyro_alpha) * self.filtered_gyro + self.gyro_alpha * corrected_gyro
                        
                        self.data[side]['real'] = -res[5] if side == 'R' else res[5]
                        # 3. 将这个“干净”的值存入 data，供后续所有逻辑使用
                        self.data[side]['gyroZ'] = self.filtered_gyro

                        # 如果是左板，顺便发一下 IMU 消息
                        if side == 'L':
                            self.publish_imu(res)

                    except Exception as e:
                        pass
    
    def publish_imu(self, res):
        """ 将原始数据封装成 ROS2 标准 IMU 格式 """
        imu_msg = Imu()
        imu_msg.header.stamp = self.get_clock().now().to_msg()
        imu_msg.header.frame_id = "imu_link"

        # 这里的数值需要根据你的传感器量程缩放，目前先发原始值观察
        # res[7,8,9] 是 accX, Y, Z
        # res[11,12,13] 是 gyroX, Y, Z
        imu_msg.linear_acceleration.x = float(res[7])
        imu_msg.angular_velocity.z = float(res[13])
        
        self.imu_pub.publish(imu_msg)

    def publish_feedback(self):
        try:
            feedback_msg = Twist()
            # 强制转换为 float，防止类型错误
            feedback_msg.linear.x = float(self.data['L']['real'])
            feedback_msg.linear.y = float(self.data['R']['real'])
            feedback_msg.angular.z = float(self.data['L']['real']-self.data['R']['real'])

            self.feedback_pub.publish(feedback_msg)

            # 调试信息：在终端看看有没有发出来
            # self.get_logger().info(f"Published: {feedback_msg.linear.x}")
        except Exception as e:
            self.get_logger().error(f"Feedback Error: {e}")
    def status_report(self):
        l, r = self.data['L'], self.data['R']
        # 现在 l['real'] 和 r['real'] 都是逻辑同向的了，差值应该接近 0
        diff = l['real'] - r['real']
        print(f"\r[稳健运行] L:{l['real']:>4} | R:{r['real']:>4} | 物理差值:{diff:>3} | 目标:{l['target']:.0f}", end='', flush=True)

def main():
    rclpy.init()
    node = SteadyMotorDriver()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        # 退出前强制发送 0 速度包
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
